# Optional environment overrides (Mixtape also reads ~/.mixtape-agent/config.json).
# Copy to .env only for your own shell scripts; Mixtape does not load .env files by itself.
# MIXTAPE_LLM_PROVIDER=claude-cli        # claude-cli | anthropic | openai
# MIXTAPE_LLM_MODEL=
# MIXTAPE_LLM_BASE_URL=
# MIXTAPE_LLM_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# MIXTAPE_PORT=4321
# MIXTAPE_HOME=                         # data folder, default ~/.mixtape-agent
# SOUNDCLOUD_CLIENT_ID=
# HTTPS_PROXY=http://127.0.0.1:7890
# NODE_USE_ENV_PROXY=1                  # Node.js 22.21+/24+: make fetch() use HTTPS_PROXY
